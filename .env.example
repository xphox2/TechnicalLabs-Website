# =============================================================================
# Technical Labs Website — Environment Configuration
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# =============================================================================

# GitHub Personal Access Token (build-time version fetching + Nginx GitHub proxy)
GITHUB_TOKEN=

# --- Booking form mail relay (SMTP) ------------------------------------------
# Used by the `mailer` service to deliver the "Schedule a Session" form.
SMTP_HOST=mail.xphox.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true only for implicit TLS on port 465; leave false for STARTTLS on 587
SMTP_SECURE=false

# Where booking requests are delivered, and the From identity they are sent as
MAIL_TO=xphox@xphox.net
MAIL_FROM=Technical Labs Website <noreply@technicallabs.org>

# --- Host port mappings (optional) -------------------------------------------
# PORT=8080
# DEV_PORT=3000
