server {
    listen 80;
    server_name localhost;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ =404;
    }

    # Booking form mail relay — forwards POST /api/schedule to the mailer service
    location = /api/schedule {
        # Docker's embedded DNS, so the "mailer" service name resolves at request
        # time (survives mailer restarts without reloading Nginx)
        resolver 127.0.0.11 valid=30s;
        set $mailer_upstream http://mailer:3001;
        proxy_pass $mailer_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Secure GitHub API proxy
    location /api/github/ {
        # DNS resolver to dynamic resolve api.github.com (required for proxy_pass to domains)
        resolver 8.8.8.8 [2001:4860:4860::8888] valid=300s;
        resolver_timeout 5s;

        proxy_pass https://api.github.com/;
        proxy_set_header Authorization "token ${GITHUB_TOKEN}";
        proxy_set_header Accept "application/vnd.github.v3+json";
        proxy_set_header User-Agent "Nginx-Reverse-Proxy";
        
        # Required for SSL handshakes to SNI-restricted hosts like GitHub
        proxy_ssl_server_name on;
        
        # Turn off buffering to stream live responses
        proxy_buffering off;

        # Optional caching to prevent rate-limit flooding from repetitive client refreshes
        proxy_cache_bypass $http_upgrade;
    }
}
